{% set navPages = collections.all | filterCollection([{ by: 'lang', value:
lang }, { by: 'parent', value: '' }]) | eleventyNavigation %}

{% if navPages | length %}

<header class="main-header palette bleed-bg {{ class }}">
    <nav id="main-nav" class="cluster">
    <!-- Main pages navigation -->
    <ul role="list" class="cluster">
        <li id="logo-item">
          <a
            href="/"
            id="nav-logo-link"
            aria-label="Accueil"
            {% if '/' == page.url %}aria-current="page"{% endif %}
            >{% partial "mookai-logo-cc.njk" %}
          </a>
        </li>
        {% for link in navPages %}
        <li>
        {# prettier-ignore #}
        <a
            href="{{link.url}}"
            class="nav-links"
            {% if link.lang %}hreflang="{{link.lang}}"{% endif %}
            {% if link.url == page.url %}aria-current="page"{% endif %}
            >{{link.title}}</a
        >
        </li>
        {% endfor %}
    </ul>

    <!-- Language navigation -->
    {% if page.url | locale_links | length %}
    <ul role="list" id="lang-nav" class="flex flex-nowrap gap-[--step--2] m0">
        {% for link in page.url | locale_links("all") %}
        <li>
        <a
            href="{{link.url}}"
            class="nav-links"
            {% if link.lang %}hreflang="{{link.lang}}"{% endif %}
            aria-current="{{ 'page' if link.lang === page.lang else 'false' }}"
            ><abbr lang="{{link.lang}}" title="{{link.label}}"
            >{{link.lang | upper}}</abbr></a>
        </li>
        {% endfor %}
    </ul>
    {% endif %}
    </nav>
</header>

<style>
:root {
 --gap-cover: 1em;

}
body > header,
body > main > header,
main > .homepage-hero-wrapper > header {
    border: none;
    box-shadow: 0px 3px 6px #00000029;
    position: sticky;
    top: 0;
    z-index: 10;
    padding-block: var(--step--2);
}
#main-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
}

#logo-item {
  flex-grow: 1;
}

#nav-logo-link {
    display: block;
    inline-size: var(--step-9);
    max-inline-size: 100%;
}

#nav-logo-link svg {
    width: 100%;
    height: auto;
}

#main-nav ul{
    inline-size: 100%;
    justify-content: flex-end;
    row-gap: .25em;
}

#main-nav a{
    text-transform: uppercase;
    text-decoration: none;
    font-size: var(--step--1);
}

#main-nav a[aria-current="page"]:not(#nav-logo-link) {
    color: var(--color-pop);
    font-weight: 700;
}
</style>
{% endif %}
