{% css %}
.homepage-hero {
    padding-block: 0;
    min-height: 100dvh;
}
.homepage-hero,
.homepage-hero > .two-columns {
    min-block-size: 100svh;
    padding: 0;
}
.homepage-hero .item-two-columns {
    padding: var(--py-section) var(--px-section);
}
.homepage-hero .item-two-columns:first-child {
    max-inline-size: calc(var(--width-body) * 0.4);
}
.homepage-hero svg {
    width: 9rem;
    height: auto;
}
.homepage-hero .cls-1 {
    fill: var(--color-read);
}
.homepage-hero .cluster p {
    display: contents;
}
.homepage-hero .item-two-columns:last-child {
    padding: 0;
    overflow: hidden;
}
.homepage-hero .item-two-columns:last-child img {
    block-size: 100%;
    inline-size: 100%;
    max-height: 100dvh;
    object-fit: cover;
    object-position: center;
}
{% endcss %}
