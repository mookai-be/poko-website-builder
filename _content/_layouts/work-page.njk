<!doctype html>
<html lang="{{lang or 'en'}}" class="no-js {{htmlClass or 'palette-mocha'}}">
  <head>
    {% partial "_html-head-default.md" %} {% getBundle "html", "head" %}
  </head>
  <body class="{{bodyClass}}">
    <!-- Navigation -->
    {% partial "headless/page-nav.11ty.js" %}

    <!-- Content -->
    {% partial "main-content-work.md" %}

    <!-- Footer -->
    {% partial "headless/page-footer.11ty.js" %}
    {% partial "_page-footer.njk" %}
    
    <!-- Injected page styles -->
    {% if pageStyles %}
    <style>
      {{pageStyles | safe}}
    </style>
    {% endif %}
  </body>
</html>
