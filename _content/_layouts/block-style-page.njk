<!doctype html>
<html lang="{{lang or 'en'}}" class="no-js {{htmlClass}}">
  <head>
    {% partial "_html-head-default.md" %} {% getBundle "html", "head" %}
  </head>
  <body class="{{bodyClass}}">
    <!-- Navigation -->
    {% partial "headless/page-nav.11ty.js" %}

    <!-- Content -->
    {% partial "_main-content.md" %}

    <!-- Footer -->
    {% partial "headless/page-footer.11ty.js" %}
  </body>

  <!-- Styles Partials -->
  {% partial "styles-huge-title.njk" %}
  {% partial "styles-blockquote-centered.njk" %}

  <!-- Injected page styles -->
  {% if pageStyles %}
  <style>
    {{pageStyles | safe}}
  </style>
  {% endif %}
</html>
