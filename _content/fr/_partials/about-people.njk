<div class="with-sidebar">
<div class="sidebar-image flow">
{% image src=metadata.image.src, alt=metadata.image.alt, class="radius-card" %}

<h3 class="h-4">{{name}}</h3>
</div>
<div class="sidebar-content flow">

<p class="h3">{{metadata.jobTitle}}</p>

{% for linkItem in metadata.links %}{% if linkItem.name == "site" %}<a href="{{ linkItem.url }}">{{ linkItem.url | replace("https://www.", "") | replace("https://", "") }}</a>{% endif %}{% endfor %}

{{ rawInput | renderContent("njk,md") | safe }}

<ul class="reset cluster" role="list">
  {% for linkItem in metadata.links %}
  {% if linkItem.name != "site" %}
  {% set iconName = "tablerOutline:brand-" ~ linkItem.name %}
  <li>{% link url=linkItem.url %}{% icon iconName %}{% endlink %}</li>
  {% endif %}
  {% endfor %}
</ul>

</div>
</div>
